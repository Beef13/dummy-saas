# Copy to .env.local for local dev. Add the same keys in Vercel → Project → Settings → Environment Variables.

# Your site's public URL (http://localhost:3000 locally, https://your-app.vercel.app in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. Used by the Stripe webhook to write subscription rows. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe → Developers → API keys (use TEST mode keys: sk_test_...)
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or from the webhook endpoint you create in the Stripe dashboard for production
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — run `npm run stripe:seed` to create them in test mode and print these values
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
